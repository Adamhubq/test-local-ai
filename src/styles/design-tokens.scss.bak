// ========================================
// NOVA STORE Design Tokens
// ========================================

// Color Palette - Based on milk/white, graphite, and black with lime accent
:root {
  /* Primary Colors */
  --color-primary: #212121; // Black base
  --color-primary-dark: #000000;
  --color-primary-light: #424242;
  
  /* Secondary Colors */
  --color-secondary: #9e9e9e; // Graphite
  --color-secondary-dark: #616161;
  --color-secondary-light: #e0e0e0;
  
  /* Accent Colors - Lime for important actions and highlights */
  --color-accent: #8BC34A; // Lime green
  --color-accent-dark: #689F38;
  --color-accent-light: #C5E1A5;
  
  /* Background Colors */
  --color-background: #ffffff; // White background
  --color-surface: #f5f5f5; // Light gray surface
  
  /* Text Colors */
  --color-text: #212121; // Dark text
  --color-text-secondary: #757575;
  --color-text-muted: #9e9e9e;
  
  /* Border Colors */
  --color-border: #e0e0e0;
  --color-border-dark: #bdbdbd;
  
  /* Status Colors */
  --color-success: #4CAF50;
  --color-success-dark: #388E3C;
  --color-success-light: #C8E6C9;
  
  --color-warning: #ff9800;
  --color-warning-dark: #f57c00;
  --color-warning-light: #ffe0b2;
  
  --color-danger: #f44336;
  --color-danger-dark: #d32f2f;
  --color-danger-light: #ffcdd2;
  
  /* Neutral Colors */
  --color-dark: #333333;
  --color-darker: #212121;
  --color-light: #f5f5f5;
  --color-lighter: #fafafa;
  --color-white: #ffffff;
  --color-gray: #9e9e9e;
  --color-gray-light: #e0e0e0;
  --color-gray-dark: #616161;
  --color-black: #000000;
}

// Typography
:root {
  --font-family-primary: 'Roboto', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
  --font-family-secondary: 'Open Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Helvetica Neue', sans-serif;
  
  /* Desktop Typography Scale */
  --font-size-xxxxl: clamp(2.5rem, 4vw, 4rem); /* Hero headings */
  --font-size-xxxl: clamp(2rem, 3.5vw, 3rem); /* Section headings */
  --font-size-xxl: clamp(1.75rem, 3vw, 2.5rem); /* Main headings */
  --font-size-xl: clamp(1.5rem, 2.5vw, 2rem); /* Subheadings */
  --font-size-lg: clamp(1.25rem, 2vw, 1.75rem); /* Section titles */
  --font-size-md: clamp(1rem, 1.5vw, 1.25rem); /* Body text */
  --font-size-sm: clamp(0.875rem, 1.25vw, 1rem); /* Small text */
  --font-size-xs: clamp(0.75rem, 1vw, 0.875rem); /* Extra small text */
  
  --font-weight-light: 300;
  --font-weight-normal: 400;
  --font-weight-medium: 500;
  --font-weight-semibold: 600;
  --font-weight-bold: 700;
  
  --line-height-tight: 1.2;
  --line-height-normal: 1.5;
  --line-height-loose: 1.8;
  
  /* Letter spacing */
  --letter-spacing-tight: -0.02em;
  --letter-spacing-normal: normal;
  --letter-spacing-wide: 0.02em;
}

// Semantic Typography Tokens
:root {
  /* Display - Large, attention-grabbing text for hero sections */
  --font-display-family: var(--font-family-primary);
  --font-display-weight: var(--font-weight-bold);
  --font-display-size: var(--font-size-xxxxl);
  --font-display-line-height: var(--line-height-tight);
  --font-display-letter-spacing: var(--letter-spacing-tight);
  
  /* Heading - Main section headings */
  --font-heading-family: var(--font-family-primary);
  --font-heading-weight: var(--font-weight-semibold);
  --font-heading-size: var(--font-size-xxxl);
  --font-heading-line-height: var(--line-height-tight);
  --font-heading-letter-spacing: var(--letter-spacing-normal);
  
  /* Title - Subheadings and section titles */
  --font-title-family: var(--font-family-primary);
  --font-title-weight: var(--font-weight-bold);
  --font-title-size: var(--font-size-xxl);
  --font-title-line-height: var(--line-height-tight);
  --font-title-letter-spacing: var(--letter-spacing-normal);
  
  /* Body - Main content text */
  --font-body-family: var(--font-family-primary);
  --font-body-weight: var(--font-weight-normal);
  --font-body-size: var(--font-size-md);
  --font-body-line-height: var(--line-height-normal);
  --font-body-letter-spacing: var(--letter-spacing-normal);
  
  /* Caption - Small text for metadata, footnotes */
  --font-caption-family: var(--font-family-primary);
  --font-caption-weight: var(--font-weight-normal);
  --font-caption-size: var(--font-size-sm);
  --font-caption-line-height: var(--line-height-tight);
  --font-caption-letter-spacing: var(--letter-spacing-normal);
  
  /* Label - Text for form labels, tags, etc. */
  --font-label-family: var(--font-family-primary);
  --font-label-weight: var(--font-weight-medium);
  --font-label-size: var(--font-size-sm);
  --font-label-line-height: var(--line-height-tight);
  --font-label-letter-spacing: var(--letter-spacing-normal);
}

// Grid System
:root {
  /* Container max-widths */
  --container-max-width-xs: 540px;
  --container-max-width-sm: 720px;
  --container-max-width-md: 960px;
  --container-max-width-lg: 1140px;
  --container-max-width-xl: 1320px;
  --container-max-width-xxl: 1500px;
  
  /* Grid gutters */
  --grid-gutter-xs: 12px;
  --grid-gutter-sm: 16px;
  --grid-gutter-md: 24px;
  --grid-gutter-lg: 32px;
  --grid-gutter-xl: 40px;
  
  /* Spacing */
  --spacing-xxs: 2px;
  --spacing-xs: 4px;
  --spacing-sm: 8px;
  --spacing-md: 16px;
  --spacing-lg: 24px;
  --spacing-xl: 32px;
  --spacing-xxl: 48px;
  --spacing-xxxl: 64px;
}

// Border Radius
:root {
  --border-radius-xs: 2px;
  --border-radius-sm: 4px;
  --border-radius-md: 8px;
  --border-radius-lg: 12px;
  --border-radius-xl: 16px;
  --border-radius-full: 50%;
}

// Box Shadow - Consistent depth approach
:root {
  --box-shadow-none: none;
  --box-shadow-1: 0 1px 3px rgba(0,0,0,0.12);
  --box-shadow-2: 0 3px 6px rgba(0,0,0,0.16);
  --box-shadow-3: 0 6px 12px rgba(0,0,0,0.18);
  --box-shadow-4: 0 10px 20px rgba(0,0,0,0.19);
  --box-shadow-5: 0 14px 28px rgba(0,0,0,0.25);
  --box-shadow-6: 0 19px 38px rgba(0,0,0,0.30);
}

// Border - Consistent approach
:root {
  --border-width: 1px;
  --border-style: solid;
  --border-color: var(--color-border);
  --border: var(--border-width) var(--border-style) var(--border-color);
}

// Transitions
:root {
  --transition-fast: all 0.2s ease;
  --transition-normal: all 0.3s ease;
  --transition-slow: all 0.5s ease;
}

// Breakpoints
:root {
  --breakpoint-xs: 0;
  --breakpoint-sm: 576px;
  --breakpoint-md: 768px;
  --breakpoint-lg: 992px;
  --breakpoint-xl: 1200px;
  --breakpoint-xxl: 1400px;
}

// Z-index
:root {
  --z-index-dropdown: 1000;
  --z-index-sticky: 1020;
  --z-index-fixed: 1030;
  --z-index-modal-backdrop: 1040;
  --z-index-modal: 1050;
  --z-index-popover: 1060;
  --z-index-tooltip: 1070;
}